        "#AI, MACHINE LEARNING AND DEEP LEARNING#\n",
        "#Homework Assignment: Fruit Classification#\n",
        "#Topic: Supervised Learning - Decision Tree Classification#\n",
        "\n",
        "#1-Import DecisionTreeClassifier from Scikit-learn#\n",
        "\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "\n",
        "#2-Create the features list#\n",
        "#[Weight, Color, Texture]#\n",
        "\n",
        "features = [\n",
        "\n",
        "    #Apples#\n",
        "    [150, 1, 1],   #Apple#\n",
        "    [160, 1, 1],   #Apple#\n",
        "    [140, 1, 2],   #Apple#\n",
        "    [170, 1, 1],   #Apple#\n",
        "\n",
        "    #Oranges#\n",
        "    [180, 2, 1],   #Orange#\n",
        "    [190, 2, 1],   #Orange#\n",
        "    [170, 2, 2],   #Orange#\n",
        "    [200, 2, 1],   #Orange#\n",
        "\n",
        "    #Bananas#\n",
        "    [120, 3, 2],   #Banana#\n",
        "    [110, 3, 2],   #Banana#\n",
        "    [130, 3, 1],   #Banana#\n",
        "    [125, 3, 2],   #Banana#\n",
        "\n",
        "    #Mango#\n",
        "    [200, 4, 1],   #Mango#\n",
        "    [220, 4, 1],   #Mango#\n",
        "    [180, 4, 1],   #Mango#\n",
        "    [210, 4, 2]    #Mango#\n",
        "]\n",
        "\n",
        "\n",
        "#3-Create the labels list#\n",
        "\n",
        "labels = [\n",
        "\n",
        "    #Apple labels#\n",
        "    \"apple\",\n",
        "    \"apple\",\n",
        "    \"apple\",\n",
        "    \"apple\",\n",
        "\n",
        "    #Orange labels#\n",
        "    \"orange\",\n",
        "    \"orange\",\n",
        "    \"orange\",\n",
        "    \"orange\",\n",
        "\n",
        "    #Banana labels#\n",
        "    \"banana\",\n",
        "    \"banana\",\n",
        "    \"banana\",\n",
        "    \"banana\",\n",
        "\n",
        "    #Mango labels (Optional Challenge)#\n",
        "    \"mango\",\n",
        "    \"mango\",\n",
        "    \"mango\",\n",
        "    \"mango\"\n",
        "]\n",
        "\n",
        "\n",
        "#4-Create a Decision Tree Classifier#\n",
        "\n",
        "model = DecisionTreeClassifier()\n",
        "\n",
        "\n",
        "#5-Train the model#\n",
        "\n",
        "model.fit(features, labels)\n",
        "\n",
        "\n",
        "#6-Create new fruit examples for prediction#\n",
        "\n",
        "new_fruit_1 = [155, 1, 1]    #Expected Apple#\n",
        "new_fruit_2 = [185, 2, 1]    #Expected Orange#\n",
        "new_fruit_3 = [115, 3, 2]    #Expected Banana#\n",
        "\n",
        "#Optional Challenge:#\n",
        "#New Mango example#\n",
        "new_fruit_4 = [205, 4, 1]    #Expected Mango#\n",
        "\n",
        "\n",
        "#7-Make predictions#\n",
        "\n",
        "prediction_1 = model.predict([new_fruit_1])\n",
        "prediction_2 = model.predict([new_fruit_2])\n",
        "prediction_3 = model.predict([new_fruit_3])\n",
        "prediction_4 = model.predict([new_fruit_4])\n",
        "\n",
        "\n",
        "#8-Display the results#\n",
        "\n",
        "print(\"FRUIT CLASSIFICATION SYSTEM\")\n",
        "\n",
        "\n",
        "print(\"New Fruit 1:\", new_fruit_1)\n",
        "print(\"Prediction :\", prediction_1[0])\n",
        "print()\n",
        "\n",
        "print(\"New Fruit 2:\", new_fruit_2)\n",
        "print(\"Prediction :\", prediction_2[0])\n",
        "print()\n",
        "\n",
        "print(\"New Fruit 3:\", new_fruit_3)\n",
        "print(\"Prediction :\", prediction_3[0])\n",
        "print()\n",
        "\n",
        "print(\"New Fruit 4:\", new_fruit_4)\n",
        "print(\"Prediction :\", prediction_4[0])\n",
        "\n",
        "#9-Test the model with different feature values#\n",
        "#created some additional test fruits and see what Decision Tree predicts#\n",
        "\n",
        "test_fruits = [\n",
        "\n",
        "    [145, 1, 1],   #Test fruit likely Apple#\n",
        "    [195, 2, 1],   #Test fruit likely Orange#\n",
        "    [118, 3, 2],   #Test fruit likely Banana#\n",
        "    [215, 4, 1],   #Test fruit likely Mango#\n",
        "    [165, 1, 2],   #Test fruit Apple#\n",
        "    [175, 2, 2]    #Test fruit Orange#\n",
        "]\n",
        "\n",
        "\n",
        "test_predictions = model.predict(test_fruits)\n",
        "\n",
        "\n",
        "print()\n",
        "print(\"ADDITIONAL TESTING\")\n",
        "\n",
        "for i in range(len(test_fruits)):\n",
        "    print(\n",
        "        \"Test Fruit\",\n",
        "        i + 1,\n",
        "        \":\",\n",
        "        test_fruits[i],\n",
        "        \"->\",\n",
        "        test_predictions[i]\n",
        "    )\n",
        "\n",
        "\n",
        "#10-Print all predictions clearly#\n",
        "\n",
        "print()\n",
        "print(\"FINAL PREDICTIONS\")\n",
        "\n",
        "print(\"Fruit 1 prediction:\", prediction_1[0])\n",
        "print(\"Fruit 2 prediction:\", prediction_2[0])\n",
        "print(\"Fruit 3 prediction:\", prediction_3[0])\n",
        "print(\"Fruit 4 prediction:\", prediction_4[0])\n",
        "\n",
        "print()\n",
        "print(\"Model testing completed successfully!\")"
      ]
